// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// On Render free tier the filesystem is ephemeral, so SQLite would lose
// session data on every restart. We use PostgreSQL via DATABASE_URL.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// A countdown timer configured by a merchant.
// `type` controls how the end time is computed at render time:
//   - "flash_sale": fixed deadline (endsAt)
//   - "evergreen":  per-visitor durationSeconds countdown, persisted via cookie
//   - "daily":      resets at midnight in the shop's timezone
model Timer {
  id              String   @id @default(cuid())
  shop            String
  name            String
  type            String   @default("flash_sale")
  endsAt          DateTime?
  durationSeconds Int?
  placement       String   @default("announcement_bar")
  targetType      String   @default("all")
  targetIds       String   @default("[]")
  headline        String   @default("Hurry! Sale ends in")
  subtext         String   @default("Don't miss out on this deal")
  endedText       String   @default("This offer has ended")
  backgroundColor String   @default("#111827")
  textColor       String   @default("#FFFFFF")
  accentColor     String   @default("#F59E0B")
  showDays        Boolean  @default(true)
  hideWhenEnded   Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop, active])
}
